      "id": "c3d4e5f6-0004-0004-0004-000000000003",
      "name": "Split In Batches — 50 por vez",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst results = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c.data_nascimento) continue;\n  const birth = new Date(c.data_nascimento);\n  birth.setHours(0, 0, 0, 0);\n  let age = today.getFullYear() - birth.getFullYear();\n  const monthDiff = today.getMonth() - birth.getMonth();\n  if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) age--;\n  const isBirthdayToday = birth.getMonth() === today.getMonth() && birth.getDate() === today.getDate();\n  const turns18 = new Date(birth);\n  turns18.setFullYear(birth.getFullYear() + 18);\n  turns18.setHours(0, 0, 0, 0);\n  const turns18Today = turns18.getTime() === today.getTime();\n  const lastSeen = c.ultima_interacao ? new Date(c.ultima_interacao) : new Date(c.criado_em);\n  const daysSince = Math.floor((today - lastSeen) / 86400000);\n  let action = null;\n  if (turns18Today) action = 'fiz18';\n  else if (isBirthdayToday && age < 18) action = 'birthday_minor';\n  else if (isBirthdayToday && (c.total_compras || 0) === 0) action = 'birthday_new';\n  else if (isBirthdayToday && (c.total_compras || 0) > 0) action = 'birthday_recurring';\n  else if (c.status === 'cancelada') action = 'cancelled';\n  else if (daysSince === 17) action = 'reactivation_2';\n  else if (daysSince === 14) action = 'reactivation_1';\n  if (action) results.push({ json: { ...c, action, age, daysSince } });\n}\nreturn results;"
      },
