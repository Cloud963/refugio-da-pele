      "id": "c3d4e5f6-0004-0004-0004-000000000005",
      "name": "IF — Tem Ação?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst { action, nome, email, telefone, age } = item;\nconst primeiroNome = nome ? nome.split(' ')[0] : 'querida';\nconst nomeF = primeiroNome.charAt(0).toUpperCase() + primeiroNome.slice(1).toLowerCase();\nconst today = new Date();\nconst ano = today.getFullYear();\nlet subject = '', emailBody = '', whatsappMsg = '', cupom = null, saveCancelamento = false;\nswitch (action) {\n  case 'fiz18':\n    const v18 = new Date(today); v18.setDate(v18.getDate() + 30);\n    cupom = { codigo: 'FIZ18', cpf: item.cpf || '', desconto: 50, validade: v18.toISOString(), usado: false };\n    subject = `🎂 Feliz 18 anos, ${nomeF}! Seu presente está aqui`;\n    emailBody = `<p>Hoje é um dia especial — você chegou nos seus 18 anos!</p><p>Como presente, liberamos o PDF completo para você. Use o cupom <strong>FIZ18</strong> e ganhe <strong>50% OFF</strong> no primeiro mês. Válido por 30 dias.</p>`;\n    whatsappMsg = `🎂 Feliz 18 anos, ${nomeF}! Seu presente do Refúgio da Pele está no email 💛`;\n    break;\n  case 'birthday_minor':\n    subject = `🌸 Feliz aniversário, ${nomeF}!`;\n    emailBody = `<p>Hoje é o seu dia, ${nomeF}! 🌸</p><p>Esperamos que seja incrível. Aqui vai uma curiosidade especial sobre cuidados com a pele para celebrar com você.</p>`;\n    whatsappMsg = null;\n    break;\n  case 'birthday_new':\n    const codNova = `ANIV${nomeF.toUpperCase()}${ano}`;\n    const vNova = new Date(today.getFullYear(), today.getMonth() + 1, 1);\n    cupom = { codigo: codNova, cpf: item.cpf || '', desconto: 50, validade: vNova.toISOString(), usado: false };\n    subject = `🎂 Feliz aniversário — seu presente especial chegou`;\n    emailBody = `<p>Feliz aniversário, ${nomeF}! 🎉</p><p>Para celebrar, preparamos <strong>50% OFF</strong> no seu primeiro pedido. Use o cupom <strong>${codNova}</strong>. Válido apenas este mês.</p>`;\n    whatsappMsg = `🎂 Feliz aniversário, ${nomeF}! Seu presente está no email 💛`;\n    break;\n  case 'birthday_recurring':\n    const desc = Math.min(age, 70);\n    const codRec = `ANIV${nomeF.toUpperCase()}${ano}`;\n    const vRec = new Date(today.getFullYear(), today.getMonth() + 1, 1);\n    cupom = { codigo: codRec, cpf: item.cpf || '', desconto: desc, validade: vRec.toISOString(), usado: false };\n    subject = `🎂 Feliz aniversário — ${desc}% OFF só para você`;\n    emailBody = `<p>Feliz aniversário, ${nomeF}! 🎉</p><p>Porque você faz parte do nosso Refúgio, seu presente é especial: <strong>${desc}% OFF</strong> — um desconto da sua idade. Cupom: <strong>${codRec}</strong>. Válido apenas este mês.</p>`;\n    whatsappMsg = `🎂 Feliz aniversário, ${nomeF}! Um presente especial chegou no seu email 💛`;\n    break;\n  case 'reactivation_1':\n    subject = `Sentimos sua falta, ${nomeF} 🌸`;\n    emailBody = `<p>Oi, ${nomeF}. Tudo bem com você?</p><p>Faz alguns dias que não nos vemos por aqui. Passamos para deixar seu último conteúdo disponível. O que mudou na sua rotina? 💛</p>`;\n    whatsappMsg = `Oi, ${nomeF} 🌸 Sentimos sua falta! Seu último PDF está esperando.`;\n    break;\n  case 'reactivation_2':\n    subject = null;\n    whatsappMsg = `Oi, ${nomeF} 🌿 Está tudo bem com você? A gente estava com saudade. Sempre que quiser, o Refúgio está aqui 💛`;\n    emailBody = null;\n    break;\n  case 'cancelled':\n    saveCancelamento = true;\n    subject = `Seu Refúgio sempre estará aqui`;\n    emailBody = `<p>${nomeF}, lamentamos que esteja partindo.</p><p>Poderia nos contar o motivo? E saiba: quando quiser voltar, a porta estará aberta — e vamos receber você como se nunca tivesse saído. 💛</p>`;\n    whatsappMsg = null;\n    break;\n}\nreturn [{ json: { ...item, subject, emailBody, whatsappMsg, cupom, saveCancelamento } }];"
      },
