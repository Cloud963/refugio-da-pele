    {
      "parameters": {
        "jsCode": "const pdfData = $('Supabase — Buscar PDF da Semana').first().json;\nconst pdf_url = pdfData[0]?.value || 'Não gerado ainda';\n\nconst leads = $('Sheets — Leads da Semana').all();\nconst hoje = new Date();\nconst seteDiasAtras = new Date(hoje.getTime() - 7 * 24 * 60 * 60 * 1000);\nconst leadsNovos = leads.filter(l => {\n  const data = new Date(l.json.Data);\n  return data >= seteDiasAtras;\n}).length;\n\nconst totalLeads = leads.length;\n\nconst agora = new Date();\nconst diasSemana = ['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'];\nconst meses = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];\nconst dataFormatada = `${agora.getDate()} de ${meses[agora.getMonth()]} de ${agora.getFullYear()}`;\n\nconst mensagem = `🌿 *Refúgio da Pele — Resumo Semanal*\n📅 ${dataFormatada}\n\n📊 *Métricas da semana:*\n• Novos leads: *${leadsNovos}*\n• Total de leads: *${totalLeads}*\n\n📄 *PDF desta semana:*\n${pdf_url}\n\n✅ *Para aprovar e publicar na segunda às 08h:*\nResponda *APROVAR* aqui\n\n❌ *Para cancelar o envio:*\nResponda *CANCELAR*\n\n— Claude, seu orquestrador 🤖`;\n\nreturn [{ json: { mensagem, pdf_url, leadsNovos, totalLeads } }];"
      },
