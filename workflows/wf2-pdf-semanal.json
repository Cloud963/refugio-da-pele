        "sendBody": true,
        "contentType": "json",
        "body": {
          "query": "={{ $('Set Tema da Semana').item.json.tema_semana }} skincare women international traditions {{ $('Set Tema da Semana').item.json.clima_semana }}",
          "api_key": "TAVILY_KEY_PLACEHOLDER",
