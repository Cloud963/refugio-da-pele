      "id": "a1b2c3d4-0001-0001-0001-000000000008",
      "name": "PDFShift — HTML para PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "credentials": { "httpBasicAuth": { "id": "pdfshift-basic-auth", "name": "PDFShift Basic Auth — CONFIGURAR" } }
    },
    {
      "parameters": {
        "jsCode": "// Calcula estrutura de pastas: Ano > Mês (pt-BR) > Semana XX\nconst now = new Date();\nconst meses = ['janeiro','fevereiro','marco','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];\nconst ano = now.getFullYear().toString();\nconst mes = meses[now.getMonth()];\nconst semana = String(Math.ceil(now.getDate() / 7)).padStart(2, '0');\nconst tema = $('Extrair Conteúdo Claude').item.json.tema_semana || 'sem-tema';\nconst nomeArquivo = `refugio-da-pele-${ano}-${mes}-semana${semana}.pdf`;\nconst nomePasta = `Semana ${semana}`;\nreturn [{ json: { ano, mes, semana, nomeArquivo, nomePasta, tema } }];"
      },
