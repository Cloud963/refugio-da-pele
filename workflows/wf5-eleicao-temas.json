      "id": "e5f6a7b8-0005-0005-0005-000000000103",
      "name": "SerpAPI — Trends Ano",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 600]
    },
    {
      "parameters": {
        "jsCode": "// Recebe 3 inputs: [0] Semana, [1] Mês, [2] Ano\n// Cada input é a resposta da SerpAPI com related_queries\nconst hoje = new Date();\nconst semana = `${hoje.getFullYear()}-W${String(Math.ceil((hoje.getDate() - hoje.getDay() + 10) / 7)).padStart(2,'0')}`;\n\nfunction extrairTopTema(inputIndex) {\n  try {\n    const data = $input.all()[inputIndex]?.json;\n    if (!data) return 'sem dados';\n    // SerpAPI google_trends retorna related_queries por keyword\n    // Verificar se existe interest_over_time ou related_queries\n    const rq = data.related_queries;\n    if (rq) {\n      // Pode ser um objeto com chaves por keyword ou array\n      const primeiraChave = Object.keys(rq)[0];\n      if (primeiraChave && rq[primeiraChave]?.top?.length > 0) {\n        return rq[primeiraChave].top[0].query || 'sem dados';\n      }\n    }\n    // Fallback: tentar interest_over_time para pegar keyword com mais interesse\n    const iot = data.interest_over_time;\n    if (iot && iot.averages && iot.averages.length > 0) {\n      const sorted = [...iot.averages].sort((a, b) => b.value - a.value);\n      return sorted[0].query || sorted[0].keyword || 'sem dados';\n    }\n    return 'sem dados';\n  } catch(e) {\n    return 'erro: ' + e.message;\n  }\n}\n\nconst tema_semana = extrairTopTema(0);\nconst tema_mes = extrairTopTema(1);\nconst tema_ano = extrairTopTema(2);\n\nreturn [{ json: { tema_semana, tema_mes, tema_ano, semana } }];"
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000104",
      "name": "Extrair Temas Trends",
