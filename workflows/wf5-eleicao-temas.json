    {
      "parameters": {
        "jsCode": "const hoje = new Date();\nconst semana = `${hoje.getFullYear()}-W${String(Math.ceil((hoje.getDate() - hoje.getDay() + 10) / 7)).padStart(2,'0')}`;\nconst rows = $input.all().map(i => i.json).filter(r => r.semana === semana && r.tema_sugerido);\nconst contagem = {};\nrows.forEach(r => { contagem[r.tema_sugerido] = (contagem[r.tema_sugerido] || 0) + 1; });\nconst ordenados = Object.entries(contagem).sort((a,b) => b[1]-a[1]).slice(0,3);\nreturn [{ json: {\n  semana,\n  tema1: ordenados[0]?.[0] || 'hidratação',\n  tema2: ordenados[1]?.[0] || 'rotina noturna',\n  tema3: ordenados[2]?.[0] || 'ingredientes naturais',\n  votos1: ordenados[0]?.[1] || 0,\n  votos2: ordenados[1]?.[1] || 0,\n  votos3: ordenados[2]?.[1] || 0\n}}];"
      },
